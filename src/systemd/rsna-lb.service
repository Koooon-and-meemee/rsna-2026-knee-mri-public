[Unit]
Description=Daily RSNA public leaderboard snapshot

[Service]
Type=oneshot
WorkingDirectory=%h/kaggle
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/env uv run python src/lb_snapshot.py
StandardOutput=append:%h/kaggle/artifacts/logs/lb.log
StandardError=append:%h/kaggle/artifacts/logs/lb.log
